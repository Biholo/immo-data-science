.env
dvf_cache.duckdb
__pycache__/
*.pyc

# ml/ run outputs (models, predictions, metrics) — regenerated by ml/scripts/run_all.py
ml/artifacts/*/
!ml/artifacts/.gitkeep

# Raw source data — too large to version, download links in README.md "Sources de données"
dvf-raw/*
!dvf-raw/.gitkeep

csv/*
!csv/*/
!csv/.gitkeep
csv/*/*
!csv/*/.gitkeep
